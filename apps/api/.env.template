# nomai — x402 seller and buyer configuration.
# Copy this file to .env and fill it in. Never commit .env.

# ---------------------------------------------------------------------------
# Network. "testnet" (default) settles on Celo Sepolia and costs nothing real.
# Switch to "mainnet" only when you mean it — settlements there move real USDC.
# ---------------------------------------------------------------------------
X402_NETWORK=testnet

# ---------------------------------------------------------------------------
# SELLER
# ---------------------------------------------------------------------------
# The platform wallet — the Service-fee destination for when Escrow
# releases run (ADR-0005/0006). It is NOT the Booking payTo: every Booking
# settles into the shared Escrow vault (ESCROW_ADDRESS below) and the Owner
# is paid by releases. Reserved for the release tooling — the request path
# does not read it.
X402_PAY_TO=

# Assets this seller accepts, comma-separated — the whitelist the Booking
# charge resolves against. A Booking charges in the Lodging's own wFIAT
# (ARS→wars, BRL→wbrl, COP→wcop, MXN→wmxn, PEN→wpen, CLP→wclp) and in USDC
# for non-fiat currencies; a listing whose token is not configured here
# fails explicitly at book time. Testnet supports "usdc" only; mainnet adds
# usdt, usat and the Ripio wFIAT stablecoins wars, wbrl, wcop, wmxn, wpen,
# wclp.
X402_ASSETS=usdc

# Optional: JSON-RPC endpoint used for on-chain reads (wFIAT balanceOf in
# /wallet/*) on whichever network X402_NETWORK selects. Defaults to the public
# Forno RPC for that network. Point it at a private RPC for reliability, or at
# a stub for smoke tests.
#X402_RPC=

# REQUIRED, on testnet too. Self-service, free to start:
#
#   1. Open https://x402.celo.org and connect an EVM wallet.
#   2. Click "Create API key" and sign the message. No gas, no transaction.
#   3. Copy the key — it looks like x402_... and is shown ONCE.
#   4. Paste it below.
#
# New accounts get free credits on both mainnet and testnet, so nothing needs to
# be bought to run this template. Each settlement spends one credit; buy more by
# depositing USDC on the same dashboard. Lost the key? "Lost your key? Regenerate
# it" issues a new one and keeps your credits.
#
# This is a SERVER-side secret. It identifies you to the facilitator, is never
# part of the payment, and is never sent to the buyer. The buyer needs no key.
#
# Worth knowing before you debug this the hard way: /supported and /verify answer
# WITHOUT a key, so the server starts fine and returns a correct 402. Only /settle
# rejects — the last step, after the buyer has already signed. It looks like
# {"error":"unauthorized","message":"Missing X-API-Key"}. Running out of credits
# fails at the same point, so check the dashboard balance too.
X402_API_KEY=

PORT=3001

# ---------------------------------------------------------------------------
# BUYER (the `pnpm api:buy` script)
# ---------------------------------------------------------------------------
# A throwaway key holding a little USDC. It needs NO CELO — the facilitator
# sponsors settlement gas. Use a wallet you are willing to lose.
BUYER_PRIVATE_KEY=

# Defaults to the local seller's open route — /paid is retired and only the
# Booking endpoint (POST /listings/:slug/book) charges. Point SELLER_URL at
# a book URL (and SELLER_METHOD=POST) to exercise a real settlement.
SELLER_URL=http://localhost:3001/free
SELLER_METHOD=GET

# ---------------------------------------------------------------------------
# SUPABASE — server-side only. Never expose these to the browser.
# Values from https://supabase.com/dashboard/project/<ref>/settings/api-keys
# Linked project ref: tspsaemylnzvdgwtjcrz
# ---------------------------------------------------------------------------
SUPABASE_URL=https://tspsaemylnzvdgwtjcrz.supabase.co

# Secret key (replaces the legacy service_role JWT). Bypasses RLS — keep it
# strictly server-side; a leak is full database access.
SUPABASE_SECRET_KEY=

# Publishable key (sb_publishable_…). NOT secret — the browser bundle already
# carries it. apps/api uses it for the per-request, JWT-scoped client the
# /owners endpoints need when a write must stay under the caller's RLS
# (e.g. onboarding inserts); the secret key would bypass those policies.
SUPABASE_PUBLISHABLE_KEY=

# JWKS endpoint for verifying Supabase-issued JWTs locally (auth tokens are
# asymmetric — no shared secret needed).
SUPABASE_JWKS_URL=https://tspsaemylnzvdgwtjcrz.supabase.co/auth/v1/.well-known/jwks.json

# Postgres password, set at project creation (or reset in Settings > Database).
# The Supabase CLI reads this for `db push` / `db pull` / migrations.
SUPABASE_DB_PASSWORD=

# Direct connection string. For serverless/pooled access prefer the pooler:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.tspsaemylnzvdgwtjcrz.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# USAGE METERING — ADR-0002 free-tier abuse controls. Credits (monedas
# Nomai) are retired: no grants, no balance. POST /usage/record prices each
# stage server-side in cost_units; GET /usage/today reports today's spend
# vs the per-account cap.
# ---------------------------------------------------------------------------
# Cost of one recorded call per stage, in usage units (numeric(12,2)).
USAGE_COST_CONVERSATION=1
USAGE_COST_CACHED_INVENTORY=5
USAGE_COST_LIVE_QUERY=10
# Daily free-tier ceilings checked BEFORE a stage='live_query' record is
# written — today's spend across ALL accounts, then per account. 429 when
# the record would push the day over. Set to 0 to disable that axis.
FREE_DAILY_BUDGET=500
FREE_DAILY_PER_ACCOUNT=50

# ---------------------------------------------------------------------------
# MCP — read-only Model Context Protocol server at /mcp (Streamable HTTP).
# Auth: `Authorization: Bearer <Supabase access_token>` on every call; the
# verified user id scopes all Traveler data. /.well-known/oauth-protected-resource
# advertises Supabase Auth as the OAuth 2.1 server for connector-style clients.
# ---------------------------------------------------------------------------
# Public origin clients use to reach THIS api (tunnel or domain, no trailing
# slash). Goes into the OAuth resource metadata + WWW-Authenticate challenges.
#NOMAI_PUBLIC_URL=http://localhost:3001
# Local dev only: when NODE_ENV != production and no Bearer header arrives,
# /mcp answers as this Traveler id. Never set on a deployed instance.
#NOMAI_MCP_DEV_TRAVELER_ID=

# ---------------------------------------------------------------------------
# LISTINGS DATA — which backend the listings/bookings API surface reads.
# "mock" (default) serves the in-memory store; "supabase" serves the linked
# project through the service-role client. The effective value is logged at
# boot — a typo here silently falls back to mock.
# ---------------------------------------------------------------------------
LISTINGS_DATA_SOURCE=mock

# Origin of the web app that hosts the curated /images/* listing photos.
# Root-relative photo paths serialize as absolute URLs against this base so
# the Agent and MCP clients can render them. Absolute photo URLs (Owner
# uploads in the listing-photos Storage bucket) pass through untouched.
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AGENT WALLETS — one per Traveler (ADR-0003).
# The API derives each Traveler's Agent wallet key from this secret +
# traveler_id; key material is never stored anywhere. REQUIRED — without it
# /wallet/* cannot create wallets and answers wallet_unavailable. Use a long
# random value, e.g. `openssl rand -hex 32`.
# ---------------------------------------------------------------------------
AGENT_WALLET_MASTER_SECRET=

# ---------------------------------------------------------------------------
# FUNDING ("Cargar") — POST /wallet/:id/funding-link builds the public Ripio
# ramp deep link: {RIPIO_RAMP_URL}?country=<payer>&chain=42220&token=<wFIAT>&
# amount=<fiat>&address=<Agent wallet>. No partner credentials are involved.
# ---------------------------------------------------------------------------
# Ramp base URL — override only for tests.
#RIPIO_RAMP_URL=https://ramp.ripio.com/
# Minimum load per currency, in fiat units; requests below it answer 400.
# FUNDING_MIN_<FIAT> overrides each default (shown here).
#FUNDING_MIN_ARS=5000
#FUNDING_MIN_BRL=25
#FUNDING_MIN_CLP=5000
#FUNDING_MIN_COP=20000
#FUNDING_MIN_MXN=100
#FUNDING_MIN_PEN=20

# ---------------------------------------------------------------------------
# SERVICE FEE (ADR-0005) — platform_settings.service_fee_pct is the source
# of truth; this env is only the fallback when the DB can't be read (and the
# default the mock repo uses before the first successful read).
# ---------------------------------------------------------------------------
SERVICE_FEE_PCT=7

# ---------------------------------------------------------------------------
# NOMAI_API_URL — base URL of THIS api, for the smoke scripts
# (scripts/smoke-*.ts) and any server-side caller. Not read by the server
# itself.
# ---------------------------------------------------------------------------
NOMAI_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# ESCROW VAULT — the shared contract every Booking's payment settles into
# (ADR-0006, minimal reading; issue #57). Ops live in scripts/escrow-*.ts:
# `pnpm escrow:deploy [sepolia|mainnet]`, `pnpm escrow:admin <command>`,
# `pnpm smoke:escrow` (in-process ganache verification, no funds needed).
# ---------------------------------------------------------------------------
# Address of the deployed vault — `pnpm escrow:deploy` prints it. Consumed
# by `pnpm escrow:admin` AND by the Booking route: since #61 it is the x402
# payTo for every Booking (ADR-0006). Unset → POST /listings/:slug/book
# answers 503 escrow_unconfigured rather than paying anyone else.
ESCROW_ADDRESS=

# ERC-8021 attribution tag appended to every tx the escrow scripts send
# (same celo_… value as apps/agent/.env). Required — untagged mainnet txs are
# never credited and cannot be backfilled.
CELO_ATTRIBUTION_TAG=

# ESCROW_ADMIN_PRIVATE_KEY — the vault admin's key (the project wallet,
# 0x8BCF810436f39cb386d0137B738a516F44d8731C). OPERATOR-SUPPLIED AT INVOCATION
# ONLY — never store it in this file or anywhere under apps/api:
#
#   ESCROW_ADMIN_PRIVATE_KEY=$(grep ^CELO_PRIVATE_KEY ../agent/.env | cut -d= -f2) \
#     pnpm escrow:deploy sepolia
#
# The scripts derive the address and abort if it isn't the project wallet.

# ---------------------------------------------------------------------------
# PAYOUT VERIFICATION (issue #68) — the Owner's Ripio deposit address is
# verified by a test deposit: POST /owners/payout/verify sends a small random
# amount (0.11–0.99) of the Owner's wFIAT from the ops wallet; the Owner
# confirms what Ripio credited.
# ---------------------------------------------------------------------------
# The project/ops wallet's key — the same wallet that administers the Escrow
# (0x8BCF810436f39cb386d0137B738a516F44d8731C). It must hold a small float of
# each wFIAT Owners verify in; POST /owners/payout/verify answers
# ops_float_insufficient when it can't cover a deposit. Never logged.
OPS_WALLET_PRIVATE_KEY=

# Smoke/ganache overrides — point the resolved wFIAT at a mock ERC-20 so the
# verification send path runs on a throwaway chain (smoke:payout sets them
# itself). Never set these on a deployed instance: the deposit would go out
# on the wrong contract.
#PAYOUT_TOKEN_ADDRESS=
#PAYOUT_TOKEN_DECIMALS=

# ---------------------------------------------------------------------------
# ESCROW KEEPER — POST /internal/keeper (ADR-0006).
# Ops-only trigger for process_escrow_releases(): a cron job (or a manual
# curl) calls it with `Authorization: Bearer <KEEPER_SECRET>` to advance the
# Escrow (funded → partially_released → released) and Booking status
# (confirmed → in_progress → completed). Unset = the endpoint answers 401 to
# everyone. Use a long random value, e.g. `openssl rand -hex 32`.
# ---------------------------------------------------------------------------
KEEPER_SECRET=
