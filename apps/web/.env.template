# nomai — web app configuration.
# Copy this file to .env.local and fill it in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Ripio Wallet API — self-service credentials (you already have these).
# Create them at https://app.ripio.com/profile?tab=api
# Auth: API key + HMAC-SHA256 signature + timestamp headers.
# Optional. Without these, GET /api/fx serves a free public fiat FX feed,
# and if that's unreachable it falls back to a static reference table.
# ---------------------------------------------------------------------------
RIPIO_API_KEY=
RIPIO_API_SECRET=
# Override only for testing — defaults to https://api.ripio.com
RIPIO_WALLET_BASE_URL=

# ---------------------------------------------------------------------------
# Ripio B2B (Ramps API) — partner credentials, NOT self-service.
# Request partner registration from Ripio support; they issue the
# client_id/client_secret pair (sandbox first, then production).
#
# Auth: OAuth2 → POST {RIPIO_BASE_URL}/oauth2/token/ with HTTP Basic.
# Sandbox:  https://skala-sandbox.ripio.com
# Producción: https://skala.ripio.com
#
# These power DISPLAY estimates only. The firm conversion — the one that
# carries the FX fee — is a held quote the Agent creates via
# POST {RIPIO_BASE_URL}/api/v1/quotes/ at Booking time.
# ---------------------------------------------------------------------------
RIPIO_BASE_URL=
RIPIO_CLIENT_ID=
RIPIO_CLIENT_SECRET=

# Escape hatch: a raw Bearer token, skipping the OAuth2 exchange (sandbox
# poking, debugging). Leave empty in normal use — tokens expire.
RIPIO_B2B_TOKEN=

# ---------------------------------------------------------------------------
# SUPABASE — safe for the browser. The NEXT_PUBLIC_ prefix inlines these into
# the client bundle; the publishable key is protected by RLS policies, not
# secrecy.
# Values from https://supabase.com/dashboard/project/<ref>/settings/api-keys
# Linked project ref: tspsaemylnzvdgwtjcrz
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tspsaemylnzvdgwtjcrz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only counterpart, if the app ever needs admin access (bypasses RLS —
# no NEXT_PUBLIC_ prefix, never reference it from client components).
# SUPABASE_SECRET_KEY=
