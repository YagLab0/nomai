# OpenCode Go API key — get yours at https://dev.opencode.ai/console/go
# (requires a Go or Go Plus subscription)
OPENCODE_GO_API_KEY=

# Model served by OpenCode Go. Run `curl https://opencode.ai/zen/go/v1/models`
# for the live list. See agent/lib/opencode-go.ts for which API protocol each
# model uses.
OPENCODE_GO_MODEL=deepseek-v4.1-flash

# Optional: override the context window (tokens) reported to eve for
# compaction. Defaults to 128000.
# OPENCODE_GO_CONTEXT_WINDOW_TOKENS=128000

# ── Celo / x402 payments (agent/lib/celo.ts, agent/lib/x402.ts) ──────────────

# Agent wallet private key — NEVER commit a real value. The agent pays Bookings
# from this wallet; its balance is the hard spend cap.
CELO_PRIVATE_KEY=

# Payment receiver for paid channels (seller side). Defaults to the
# CELO_PRIVATE_KEY address.
# PAYEE_ADDRESS=

# Dev on Celo Sepolia (USDC faucet at https://faucet.circle.com).
# Switch to "mainnet" only when going live — wFIAT (wARS/wBRL/wCOP) settles there.
X402_NETWORK=sepolia

# What paid channels charge. Sepolia supports "usdc" only; mainnet adds
# usdt, usat, wars, wbrl, wcop. PAID_PRICE is in whole tokens.
PAID_ASSET=usdc
PAID_PRICE=0.01

# Facilitator API key for /settle — free at https://x402.celo.org
# (connect the seller wallet, sign once). Without it payments are
# verified but NOT settled (dev dry-run).
# X402_API_KEY=

# Hackathon attribution tag (celo_…, issued at registration). Goes into
# every tx data suffix; set before the first mainnet transaction.
# CELO_ATTRIBUTION_TAG=
